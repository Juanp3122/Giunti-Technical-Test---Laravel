.hero
  background #fff
  border-bottom 1px solid rgba(primary, .1)

  &__inner
    display grid
    align-items center
    gap 2.5rem
    padding-top 4rem
    padding-bottom 4rem
    @media (min-width: 768px)
      padding-top 6rem
      padding-bottom 6rem
    @media (min-width: 1024px)
      grid-template-columns 1fr 1fr
      gap 3.5rem

  &__badge
    display inline-block
    padding .25rem .75rem
    border-radius 999px
    background rgba(accent, .1)
    color primary
    font-size .75rem
    font-weight 600
    letter-spacing .05em
    text-transform uppercase

  &__title
    margin-top 1.25rem
    font-size 2.25rem
    font-weight 700
    line-height 1.15
    letter-spacing -.025em
    span
      color primary
    @media (min-width: 640px)
      font-size 3rem
    @media (min-width: 1280px)
      font-size 3.75rem

  &__text
    max-width 40rem
    margin-top 1.5rem
    font-size 1.125rem
    line-height 1.7
    color rgba(ink, .7)

  &__media
    position relative
    aspect-ratio unquote('4 / 3')
    overflow hidden
    border-radius 1rem
    background linear-gradient(135deg, primary, accent)
    box-shadow 0 20px 25px -5px rgba(0, 0, 0, .1), 0 8px 10px -6px rgba(0, 0, 0, .1)
    img
      position absolute
      inset 0
      width 100%
      height 100%
      object-fit cover
    // Velo con gradiente sobre la imagen
    &::after
      content ''
      position absolute
      inset 0
      background linear-gradient(to top right, rgba(primary, .7), rgba(primary, .2), transparent)