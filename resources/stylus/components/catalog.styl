.catalog
  padding 3rem 0
  &__title
    margin-bottom 1.5rem
    font-size 1.875rem
    font-weight 700

// Filtro por categoría
.filter
  display flex
  flex-wrap wrap
  gap .5rem
  margin-bottom 2rem

  &__btn
    display inline-flex
    align-items center
    gap .5rem
    padding .5rem 1rem
    border 1px solid rgba(primary, .25)
    border-radius 999px
    background #fff
    color ink
    font-size .875rem
    font-weight 500
    transition background .2s, color .2s, border-color .2s
    &:hover
      border-color accent
      color primary
    &.is-active
      border-color primary
      background primary
      color #fff

  &__count
    padding .125rem .5rem
    border-radius 999px
    background surface
    color primary
    font-size .75rem
    .is-active &
      background rgba(#fff, .2)
      color #fff

.empty
  padding 4rem 0
  text-align center
  color rgba(ink, .6)

// Grilla: 1 columna móvil, 2 tablet, 3 desktop
.grid
  display grid
  grid-template-columns 1fr
  gap 1.5rem
  @media (min-width: 768px)
    grid-template-columns repeat(2, 1fr)
  @media (min-width: 1024px)
    grid-template-columns repeat(3, 1fr)

// Card
.card
  display flex
  flex-direction column
  height 100%
  overflow hidden
  border 1px solid rgba(primary, .1)
  border-radius .75rem
  background #fff
  box-shadow 0 1px 2px rgba(0, 0, 0, .05)
  cursor pointer
  transition transform .3s, box-shadow .3s, border-color .3s

  &:hover
    border-color rgba(accent, .5)
    box-shadow 0 20px 25px -5px rgba(0, 0, 0, .1), 0 8px 10px -6px rgba(0, 0, 0, .1)
    .card__title
      color primary

  &__media
    position relative
    aspect-ratio unquote('16 / 10')
    overflow hidden
    background surface

  &__img
    position absolute
    inset 0
    width 100%
    height 100%
    object-fit cover
    transition transform .5s

  &__placeholder
    position absolute
    inset 0
    display flex
    align-items center
    justify-content center
    color rgba(primary, .4)
    svg
      width 3rem
      height 3rem

  &__body
    display flex
    flex 1
    flex-direction column
    padding 1.25rem

  &__title
    font-size 1.125rem
    font-weight 600
    line-height 1.3
    transition color .2s

  &__author
    margin-top .25rem
    font-size .875rem
    color rgba(ink, .7)

  &__meta
    margin-top .75rem
    font-size .875rem
    font-weight 500
    color primary

  &__prices
    display flex
    flex-wrap wrap
    align-items baseline
    gap .25rem .5rem
    margin-top 1rem
    margin-bottom 1.25rem

  &__price
    font-size 1.25rem
    font-weight 700

  &__old
    font-size .875rem
    color rgba(ink, .5)

  &__off
    padding .125rem .375rem
    border-radius .25rem
    background rgba(accent, .15)
    color primary
    font-size .75rem
    font-weight 600

  &__cta
    margin-top auto
    padding .625rem 1rem

// Movimiento solo si el usuario no pidió reducirlo
@media (prefers-reduced-motion: no-preference)
  .card:hover
    transform translateY(-.25rem)
    .card__img
      transform scale(1.05)

// Badge de formato
.badge
  position absolute
  top .75rem
  left .75rem
  padding .25rem .75rem
  border-radius 999px
  font-size .75rem
  font-weight 600
  box-shadow 0 1px 3px rgba(0, 0, 0, .15)
  &--cartaceo
    background #fff
    color primary
  &--digitale
    background accent
    color #fff
  &--corso-online
    background primary
    color #fff
  &--in-presenza
    background ink
    color #fff