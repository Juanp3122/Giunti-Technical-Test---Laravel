.footer
  background ink
  color #fff

  &__inner
    display flex
    flex-direction column
    gap 2.5rem
    padding-top 3rem
    padding-bottom 3rem
    @media (min-width: 768px)
      flex-direction row
      align-items flex-start
      justify-content space-between

  &__brand
    max-width 24rem
    img
      width auto
      height 2.5rem
    p
      margin-top 1rem
      font-size .875rem
      line-height 1.7
      color rgba(#fff, .7)

  &__heading
    font-size .875rem
    font-weight 600
    letter-spacing .05em
    text-transform uppercase

  &__links
    margin-top 1rem
    li + li
      margin-top .5rem
    a
      font-size .875rem
      color rgba(#fff, .7)
      transition color .2s
      &:hover
        color accent

  &__social
    display flex
    gap .75rem
    margin-top 1rem
    a
      display flex
      align-items center
      justify-content center
      width 2.5rem
      height 2.5rem
      border 1px solid rgba(#fff, .2)
      border-radius 50%
      color rgba(#fff, .8)
      transition background .2s, border-color .2s, color .2s
      &:hover
        border-color accent
        background accent
        color #fff
    svg
      width 1.25rem
      height 1.25rem

  &__copy
    padding 1.5rem 0
    border-top 1px solid rgba(#fff, .15)
    font-size .875rem
    text-align center
    color rgba(#fff, .6)
    @media (min-width: 768px)
      text-align left