.contact
  padding 4rem 0
  border-top 1px solid rgba(primary, .1)
  background surface

  &__inner
    max-width 42rem
    margin 0 auto

  &__title
    font-size 1.875rem
    font-weight 700

  &__lead
    margin-top .5rem
    color rgba(ink, .7)

  &__card
    margin-top 2rem
    padding 1.5rem
    border 1px solid rgba(primary, .1)
    border-top 4px solid accent
    border-radius .75rem
    background #fff
    box-shadow 0 1px 2px rgba(0, 0, 0, .05)
    @media (min-width: 640px)
      padding 2rem

.field
  label
    display block
    margin-bottom .375rem
    font-size .875rem
    font-weight 500
    span
      color danger
  input, textarea
    width 100%
    padding .625rem 1rem
    border 1px solid rgba(primary, .25)
    border-radius .5rem
    background #fff
    color ink
    font-size .875rem
    outline none
    transition border-color .2s, box-shadow .2s
    &::placeholder
      color rgba(ink, .4)
    &:focus
      border-color accent
      box-shadow 0 0 0 3px rgba(accent, .3)
  textarea
    resize vertical
  &__error
    margin-top .375rem
    font-size .875rem
    color danger
  &.has-error
    input, textarea
      border-color danger
      &:focus
        box-shadow 0 0 0 3px rgba(danger, .2)

.field + .field
  margin-top 1.25rem

#contact-form .btn
  margin-top 1.25rem

.success
  padding 1.5rem 0
  text-align center
  &__icon
    display flex
    align-items center
    justify-content center
    width 3.5rem
    height 3.5rem
    margin 0 auto
    border-radius 50%
    background rgba(accent, .15)
    color primary
    svg
      width 1.75rem
      height 1.75rem
  &__title
    margin-top 1rem
    font-size 1.25rem
    font-weight 600
  &__text
    margin-top .5rem
    font-size .875rem
    color rgba(ink, .7)
    strong
      color ink
  .btn
    margin-top 1.5rem