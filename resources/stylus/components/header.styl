.header
  position sticky
  top 0
  z-index 50
  background rgba(#fff, .9)
  backdrop-filter blur(8px)
  border-bottom 1px solid rgba(primary, .15)

  &__inner
    display flex
    flex-wrap wrap
    align-items center
    gap .75rem 2rem
    padding-top .75rem
    padding-bottom .75rem

  &__logo
    order 1
    img
      width auto
      height 2.25rem
      @media (min-width: 640px)
        height 2.5rem

  &__toggle
    order 2
    display flex
    align-items center
    justify-content center
    width 2.5rem
    height 2.5rem
    margin-left auto
    border 0
    border-radius .375rem
    background transparent
    color ink
    transition background .2s
    &:hover
      background surface
    .icon-close
      display none
    &[aria-expanded="true"]
      .icon-open
        display none
      .icon-close
        display block
    @media (min-width: 768px)
      display none

  &__nav
    display none
    order 2
    @media (min-width: 768px)
      display block
    ul
      display flex
      align-items center
      gap 1.5rem
    a
      padding-bottom .125rem
      border-bottom 2px solid transparent
      font-size .875rem
      font-weight 500
      color rgba(ink, .7)
      transition color .2s, border-color .2s
      &:hover
        color primary
        border-color accent

  &__mobile
    order 3
    width 100%
    overflow hidden
    border 1px solid rgba(primary, .1)
    border-radius .5rem
    background #fff
    li + li
      border-top 1px solid rgba(primary, .1)
    a
      display block
      padding .75rem 1rem
      font-weight 500
      transition background .2s, color .2s
      &:hover
        background surface
        color primary
    @media (min-width: 768px)
      display none

  &__tools
    order 4
    display flex
    align-items center
    gap .75rem
    width 100%
    @media (min-width: 768px)
      order 3
      width auto
      margin-left auto

.search
  position relative
  flex 1
  @media (min-width: 768px)
    flex none
    width 16rem
  svg
    position absolute
    top 50%
    left .75rem
    width 1rem
    height 1rem
    transform translateY(-50%)
    color rgba(primary, .6)
    pointer-events none
  input
    width 100%
    padding .5rem 1rem .5rem 2.25rem
    border 1px solid rgba(primary, .25)
    border-radius 999px
    background surface
    color ink
    font-size .875rem
    outline none
    transition border-color .2s, background .2s, box-shadow .2s
    &::placeholder
      color rgba(ink, .5)
    &:focus
      border-color accent
      background #fff
      box-shadow 0 0 0 3px rgba(accent, .3)