*, *::before, *::after
  box-sizing border-box

html
  scroll-behavior smooth

body
  margin 0
  font-family system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif
  line-height 1.5
  color ink
  background #fff
  -webkit-font-smoothing antialiased

img
  display block
  max-width 100%

a
  color inherit
  text-decoration none

ul
  margin 0
  padding 0
  list-style none

h1, h2, h3, p
  margin 0

button, input, textarea
  font inherit

// El atributo hidden siempre gana, aunque el elemento tenga display propio
[hidden]
  display none !important

// Cursor de mano en botones (equivale al fix que hicimos en Next)
button:not(:disabled)
  cursor pointer

*:focus-visible
  outline 2px solid accent
  outline-offset 2px

section[id]
  scroll-margin-top 5rem

.container
  width 100%
  max-width 80rem
  margin 0 auto
  padding 0 1rem
  @media (min-width: 640px)
    padding 0 1.5rem

// Botones
.btn
  display inline-block
  padding .5rem 1.25rem
  border 0
  border-radius 999px
  background primary
  color #fff
  font-size .875rem
  font-weight 600
  text-align center
  transition background .2s, border-color .2s
  &:hover:not(:disabled)
    background primary-dark
  &:disabled
    opacity .7
    cursor not-allowed
  &--block
    width 100%
  &--lg
    padding .75rem 1.25rem
  &--outline
    border 1px solid rgba(primary, .3)
    background transparent
    color primary
    &:hover:not(:disabled)
      border-color accent
      background surface